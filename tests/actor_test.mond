(use otp/actor)
(use otp/actor [StartError Next])
(use std/process)
(use std/process [ExitReason])
(use std/result [Result])
(use std/testing [assert_eq])

(type CounterMessage
  [Increment
   (GetValue ~ (process/Subject Int))
   Shutdown])

(let handle_counter_message {count message}
  (match message
    Increment ~> (actor/continue (+ count 1))
    (GetValue reply_subject) ~>
      (do (process/send reply_subject count)
          (actor/continue count))
    Shutdown ~> (Stop Normal)))

(let expect_process_error_kind {result expected_kind}
  (match result
    (Error err) ~> (assert_eq (process/error_kind err) expected_kind)
    (Ok _) ~> (Error "expected process error")))

(test
  "actor/start, send, call, stop"
  (let [builder (actor/on_message handle_counter_message (actor/new 0))]
    (match (actor/start builder)
      (Error _) ~> (Error "actor failed to start")
      (Ok started) ~> (let [subject (:data started) pid (:pid started)]
                        (let? [_ (assert_eq
                                 (actor/send subject Increment)
                                 (Ok ()))]
                          (let? [_ (assert_eq
                                   (actor/send subject Increment)
                                   (Ok ()))]
                            (let? [_ (assert_eq
                                     (actor/call
                                       subject
                                       200
                                       (f {reply} -> (GetValue reply)))
                                     2)]
                              (let? [_ (assert_eq
                                       (actor/send subject Shutdown)
                                       (Ok ()))]
                                (do (process/sleep 20)
                                    (assert_eq (process/is_alive pid) False))))))))))

(let failing_init {_subject}
  (Error "boom"))

(test
  "actor/start returns InitFailed when initialiser errors"
  (let [builder (actor/new_with_initialiser 50 failing_init)]
    (match (actor/start builder)
      (Error (InitFailed reason)) ~> (assert_eq reason "boom")
      (Error _) ~> (Error "expected InitFailed")
      (Ok _) ~> (Error "expected start failure"))))

(let slow_init {subject}
  (do (process/sleep 200)
      (Ok
        (|> (actor/initialised 0)
            (actor/returning subject)))))

(test
  "actor/start returns InitTimeout when initialiser is too slow"
  (let [reply (process/new_subject)
        _ (process/spawn_unlinked (f {_} ->
          (do (process/send
                reply
                (actor/start (actor/new_with_initialiser 20 slow_init)))
              ())))]
    (match (process/receive_timeout reply 1000)
      (Ok (Error InitTimeout)) ~> (Ok ())
      (Ok _) ~> (Error "expected InitTimeout")
      (Error _) ~> (Error "timed out waiting for timeout result"))))

(let exiting_init {subject}
  (do (process/send_exit (process/self))
      (Ok
        (|> (actor/initialised 0)
            (actor/returning subject)))))

(test
  "actor/start returns InitExited when initialiser exits"
  (let [builder (actor/new_with_initialiser 200 exiting_init)]
    (match (actor/start builder)
      (Error (InitExited Normal)) ~> (Ok ())
      (Error (InitExited _)) ~> (Error "expected InitExited Normal")
      (Error _) ~> (Error "expected InitExited")
      (Ok _) ~> (Error "expected start failure"))))

(type SelectorMessage
  [SwitchOff
   (Probe ~ (process/Subject Int))])

(let handle_selector_message {state message}
  (match message
    SwitchOff ~> (|> (actor/continue state)
                     (actor/with_selector (process/new_selector)))
    (Probe reply_subject) ~>
      (do (process/send reply_subject state)
          (actor/continue (+ state 1)))))

(test
  "actor/with_selector switches mailbox selection"
  (let [builder (actor/on_message handle_selector_message (actor/new 10))]
    (match (actor/start builder)
      (Error _) ~> (Error "actor failed to start")
      (Ok started) ~> (let [default_subject (:data started)
                            pid (:pid started)
                            reply_before (process/new_subject)
                            reply_ignored (process/new_subject)]
                        (let? [_ (assert_eq
                                 (actor/send
                                   default_subject
                                   (Probe reply_before))
                                 (Ok ()))]
                          (let? [_ (assert_eq
                                   (process/receive_timeout reply_before 200)
                                   (Ok 10))]
                            (let? [_ (assert_eq
                                     (actor/send default_subject SwitchOff)
                                     (Ok ()))]
                              (do (process/sleep 20)
                                  (let? [_ (assert_eq
                                           (actor/send
                                             default_subject
                                             (Probe reply_ignored))
                                           (Ok ()))]
                                    (let? [_ (expect_process_error_kind
                                             (process/receive_timeout
                                               reply_ignored
                                               30)
                                             "timeout")]
                                      (do (process/unlink pid)
                                          (process/kill pid)
                                          (process/sleep 20)
                                          (assert_eq
                                            (process/is_alive pid)
                                            False))))))))))))

(test
  "actor/named fails when name already registered"
  (let [name (process/new_name "actor-name-conflict")
        builder (|> (actor/new 0)
                    (actor/on_message handle_counter_message)
                    (actor/named name))]
    (match (actor/start builder)
      (Error _) ~> (Error "first actor failed to start")
      (Ok started) ~> (let [subject (:data started)]
                        (let? [_ (match (actor/start builder)
                                 (Error (InitFailed reason)) ~> (assert_eq
                                                                  reason
                                                                  "name already registered")
                                 (Error _) ~> (Error "expected InitFailed")
                                 (Ok _) ~> (Error
                                             "expected named start failure"))]
                          (assert_eq (actor/send subject Shutdown) (Ok ())))))))
